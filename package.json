{
  "name": "dsh-research-workbench",
  "version": "0.1.0",
  "description": "Native research workspace panels for DeepSeek Harness Web UI",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "research",
    "papers",
    "slides",
    "experiments",
    "project-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoyan96/dsh-research-workbench.git"
  },
  "homepage": "https://github.com/luoyan96/dsh-research-workbench#readme",
  "bugs": {
    "url": "https://github.com/luoyan96/dsh-research-workbench/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
